# AI PLM PostgreSQL
# Copy to .env.local or set these values in the deployment environment.
DATABASE_URL=postgresql://ai_plm_user:CHANGE_ME@127.0.0.1:5432/jsolution_ai_plm
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Storage is intentionally independent from PostgreSQL.
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage

# AI provider is intentionally independent from database/storage.
AI_PROVIDER=openai
